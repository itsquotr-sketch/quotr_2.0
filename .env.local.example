NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public site ORIGIN for auth email redirectTo (confirm / reset).
# Origin only — no path. No trailing slash required (normalised in code).
# Local:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preview (stable branch alias for hardening/stage-2a-security — prefer this,
# NOT a commit-specific *.vercel.app URL):
#   NEXT_PUBLIC_SITE_URL=https://quotr-2-0-git-hardening-stage-2a-security-quotr1.vercel.app
# Production (set only when the live domain is approved — do not invent):
#   NEXT_PUBLIC_SITE_URL=https://<production-domain-when-approved>
# Hosted Preview Supabase: https://shhpjsoldmqtkdbgrbtm.supabase.co
# Production Supabase: https://lxvnylhsbvudzzupxeqr.supabase.co — never ordinary localhost.
# See docs/runbooks/STAGE_3_1C2B_AUTH_URL_CONFIGURATION.md
# Environment topology: docs/architecture/QUOTR_ENVIRONMENT_ARCHITECTURE.md
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted Preview project ref (20 chars). Never set this to Production
# lxvnylhsbvudzzupxeqr. Used by npm run db:preview:*.
# QUOTR_SUPABASE_PREVIEW_PROJECT_REF=

# Server-only — NEVER prefix with NEXT_PUBLIC_ or import in client components.
# NOT required for normal signup after Stage 3.1C.1B (authenticated RPC provisioning).
# Still used by server-only admin tooling / local verification scripts
# (lib/supabase/admin.ts). Optional at build; set for admin/ops paths that need it.
# Preview Vercel must use the Preview project's service role. Production Vercel
# must keep the Production project's service role.
# See docs/PRODUCTION_READINESS.md.
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Live AI integration tests (fact-coverage / outdoor / internal extraction).
# Absent or any value other than 1 = skip paid model calls.
# RUN_LIVE_AI_TESTS=1

# Intelligent Scope Discovery — Preview / controlled rollout only.
# Exact value "true" enables. Absent, empty, or any other value = disabled.
# Never set on Production without owner Production gate approval.
# Never use NEXT_PUBLIC_SCOPE_DISCOVERY_ENABLED.
# SCOPE_DISCOVERY_ENABLED=true

# Optional: feedback mailto recipient for Report issue links
NEXT_PUBLIC_FEEDBACK_EMAIL=

# Quote / team application email (server-only). Never prefix NEXT_PUBLIC_.
# Provider: Resend. Owner must authenticate sending domain (SPF/DKIM/DMARC)
# before Preview/Production send will work.
# RESEND_API_KEY=
# Fallback application From (also used if channel-specific From is unset):
# RESEND_FROM_EMAIL=Quotr <no-reply@get-quotr.com>
# Team invites (application Resend, not Auth SMTP):
# RESEND_TEAM_FROM_EMAIL=Quotr <no-reply@get-quotr.com>
# Quote emails:
# RESEND_QUOTE_FROM_EMAIL=quotes@get-quotr.com
# Do not use quotes@quotes.get-quotr.com.
# Quote Reply-To is organisation contact email only (omit if missing).
# RESEND_WEBHOOK_SECRET=whsec_...
# Optional local adapter (never send real mail):
# QUOTE_DELIVERY_PROVIDER=mock
#
# Live delivery integration tests only. Absent or any value other than 1 = skip.
# RUN_LIVE_DELIVERY_TESTS=1

# BILLING-1 organisation subscription authority (server-only).
# Do not prefix Stripe secrets with NEXT_PUBLIC_.
# Do not add a publishable key until BILLING-3 Checkout / Stripe.js.
# Preview: BILLING_ENVIRONMENT=test and Stripe TEST keys only.
# Production: BILLING_ENVIRONMENT=live and Stripe LIVE keys only (not in BILLING-1).
# Local default: unset BILLING_ENVIRONMENT → test. Never live locally.
# Never mix test/live. See docs/architecture/QUOTR_BILLING_ARCHITECTURE.md
# BILLING_ENVIRONMENT=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BUILDER_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_BASE_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_SEAT_MONTHLY=price_...
# TRIAL_PAYMENT_METHOD_REQUIRED=false

# BILLING-2 entitlement enforcement (server-only).
# off = evaluate only, never deny.
# compatibility = enforce initialized billing; orgs with no billing row stay usable (BILLING-2 Preview default).
# strict = missing billing row blocks value-producing work (test / BILLING-3+).
# Unset → compatibility. Unknown values fail closed.
# BILLING_ENFORCEMENT_MODE=compatibility

# BILLING-3 Checkout / Portal (Stripe TEST only on Preview).
# Checkout success/cancel URLs use NEXT_PUBLIC_SITE_URL (stable Preview origin).
# Do not set a Production URL here.
# Optional NZ 15% GST tax rate ID from Stripe TEST Dashboard (txr_...).
# Missing: Checkout/upgrade show exclusive price with no GST line (do not invent 15%).
# Present: exclusive price + configured 15% GST on Checkout and Builder→Business update.
# STRIPE_TAX_RATE_NZ_GST=txr_...
# After applying 048, set DB billing_runtime_config.billing_environment=test on Preview
# (service_role/postgres). Do not put test/live in this file as DB authority.
# Optional Customer Portal configuration that disables plan/seat switching.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# BILLING_ENFORCEMENT_MODE=strict only after Preview bootstrap proof.
# Do not set strict on Production in BILLING-3.

