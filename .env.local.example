NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public site ORIGIN for auth email redirectTo (confirm / reset).
# Origin only — no path. No trailing slash required (normalised in code).
# Local:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preview (stable branch alias for hardening/stage-2a-security — prefer this,
# NOT a commit-specific *.vercel.app URL):
#   NEXT_PUBLIC_SITE_URL=https://quotr-2-0-git-hardening-stage-2a-security-quotr1.vercel.app
# Production (set only when the live domain is approved — do not invent):
#   NEXT_PUBLIC_SITE_URL=https://<production-domain-when-approved>
# See docs/runbooks/STAGE_3_1C2B_AUTH_URL_CONFIGURATION.md
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER prefix with NEXT_PUBLIC_ or import in client components.
# NOT required for normal signup after Stage 3.1C.1B (authenticated RPC provisioning).
# Still used by server-only admin tooling / local verification scripts
# (lib/supabase/admin.ts). Optional at build; set for admin/ops paths that need it.
# See docs/PRODUCTION_READINESS.md.
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Live AI integration tests (fact-coverage / outdoor / internal extraction).
# Absent or any value other than 1 = skip paid model calls.
# RUN_LIVE_AI_TESTS=1

# Intelligent Scope Discovery — Preview / controlled rollout only.
# Exact value "true" enables. Absent, empty, or any other value = disabled.
# Never set on Production without owner Production gate approval.
# Never use NEXT_PUBLIC_SCOPE_DISCOVERY_ENABLED.
# SCOPE_DISCOVERY_ENABLED=true

# Optional: feedback mailto recipient for Report issue links
NEXT_PUBLIC_FEEDBACK_EMAIL=
